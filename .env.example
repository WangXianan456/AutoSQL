AUTOSQL_DATABASE_URL=postgresql://autosql:autosql@127.0.0.1:5432/autosql

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_COMPLETIONS_PATH=/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60

AUTOSQL_DEFAULT_SEARCH_LIMIT=8
AUTOSQL_MAX_CONTEXT_TABLES=10
AUTOSQL_MAX_COLUMNS_PER_TABLE=80
AUTOSQL_DEFAULT_SQL_LIMIT=100
AUTOSQL_MAX_SQL_LIMIT=1000
